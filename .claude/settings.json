{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(uv run --python 3.12 --no-sync python scripts/check.py)",
      "Bash(uv run --python 3.12 --no-sync python -m pytest tests/unit:*)",
      "Bash(uv run --python 3.12 --no-sync python -m ruff check:*)",
      "Bash(uv run --python 3.12 --no-sync python -m mypy:*)",
      "Bash(bash scripts/run_db_suite.sh:*)"
    ],
    "ask": [
      "Bash(git pull:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git stash:*)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(uv lock:*)",
      "Bash(uv sync:*)",
      "Bash(uv pip:*)",
      "Bash(pip install:*)",
      "Bash(docker:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh:*)",
      "Edit(pyproject.toml)",
      "Edit(uv.lock)",
      "Edit(docs/specs/**)",
      "Write(docs/specs/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push --mirror:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(docker system:*)",
      "Bash(docker volume:*)",
      "Bash(docker image prune:*)",
      "Bash(docker container prune:*)",
      "Bash(docker builder prune:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker compose down --volumes:*)",
      "PowerShell(Remove-Item -Recurse:*)",
      "PowerShell(Get-Content *.env*)",
      "mcp__Neon__*"
    ]
  }
}
