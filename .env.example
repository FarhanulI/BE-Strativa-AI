# ---- Dev / FE integration (copy to repository-root .env.local; `just dev` forces APP_ENV=dev) ----
# APP_ENV=dev
# NEON_BRANCH_NAME=dev
# Pooled and direct URLs of the Neon DEV branch (never the test or production branch).
# DATABASE_URL=
# DATABASE_URL_DIRECT=
# Redis for login throttling; `just dev` starts it in WSL on this port and defaults REDIS_URL to it.
# REDIS_URL=redis://127.0.0.1:16379/0
# HS256 signing key for access tokens, at least 32 bytes. Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# AUTH_JWT_SECRET=
# Optional: LOG_LEVEL=INFO, MATURITY_COLD_START_THRESHOLD=5, MATURITY_MATURE_THRESHOLD=30.
# Not configurable (code constants in app/auth): access-token TTL 15 min (`expires_in` 900),
# refresh-token TTL 30 days, refresh cookie `refresh_token` (HttpOnly, Secure, SameSite=Lax,
# Path=/api/v1/auth). The FE BFF is server-to-server, so no CORS or cookie settings are needed here.

# Test setup: copy these keys to repository-root .env.test.local.
# Set APP_ENV=test and NEON_BRANCH_NAME=test explicitly in that file.
# Invoke DB verification with APP_ENV=test as well; never rely on a default branch.
APP_ENV=
NEON_BRANCH_NAME=
# Pooled URL for the dedicated Neon test branch, not dev or production.
DATABASE_URL=
# Direct URL for that SAME test branch/database/role. Set either direct alias.
# If both aliases are set, their complete values must be identical.
DATABASE_URL_DIRECT=
DATABASE_URL_UNPOOLED=
# Required for the real worker/demo. For temporary local verification, a real
# Redis server can run at redis://127.0.0.1:16379/15; no fake Redis is substituted.
REDIS_URL=
AUTH_JWT_SECRET=
EMBEDDING_DIM=
# Local Docker test database (TEST_DB_MODE=local, see README "Test database modes").
# Set TEST_DB_MODE=local in the PROCESS environment (never in a file), and copy the keys
# below to repository-root .env.test.docker.local. Do not set NEON_BRANCH_NAME there.
# Host must be 127.0.0.1 and the database name must end in _test. Use your own password
# (the same value as TEST_DB_PASSWORD given to compose.test-db.yaml).
# APP_ENV=test
# DATABASE_URL=postgresql://app_test:<TEST_DB_PASSWORD>@127.0.0.1:55444/strativa_test
# DATABASE_URL_DIRECT=postgresql://app_test:<TEST_DB_PASSWORD>@127.0.0.1:55444/strativa_test
# Dev uses .env.local with APP_ENV=dev and NEON_BRANCH_NAME=dev instead.
# Do not commit populated local files. The branch label validates configuration,
# not Neon identity: independently confirm URL endpoints belong to the test branch
# before downgrade/reset. See docs/reports/phase0-verification.md for exact commands.